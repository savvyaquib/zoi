# Copy to .env.local (gitignored) and fill in. Nothing here ships to the browser
# except the NEXT_PUBLIC_ one.

# ── Careers form → HR inbox ──────────────────────────────────────────────────
# resend.com → API Keys. Required for the form to send at all.
RESEND_API_KEY=
# Where applications land. Server-only; never appears in the page.
CAREERS_TO_EMAIL=
# Until zoiworld.com is verified in Resend, only onboarding@resend.dev can send —
# and only to the address the Resend account was created with.
CAREERS_FROM_EMAIL=onboarding@resend.dev

# ── Cloudflare Turnstile (optional until set; mandatory once set) ────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
